# =============================================================================
# Portfolio Dashboard — Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
#
# HOW MULTI-ACCOUNT LOADING WORKS
# ────────────────────────────────
# The dashboard auto-discovers Zerodha accounts by scanning for any env var
# matching:   ZERODHA_<TAG>_API_KEY
#
# TAG can be any identifier you choose — ACC1, PRIMARY, TRADING, FAMILY, etc.
# Accounts are loaded in alphabetical TAG order (ACC1 before ACC2, etc.).
# To add a new account: add a new ZERODHA_<TAG>_* block below and restart.
# To disable an account: remove or comment-out its block (no code change needed).
#
# REQUIRED per account:
#   ZERODHA_<TAG>_API_KEY
#   ZERODHA_<TAG>_ACCESS_TOKEN   ← regenerate daily at kite.zerodha.com
#
# OPTIONAL per account:
#   ZERODHA_<TAG>_API_SECRET     (only needed for automated token refresh)
#   ZERODHA_<TAG>_USER_ID        (Zerodha client ID, e.g. AB1234)
#   ZERODHA_<TAG>_DISPLAY_NAME   (label shown in the UI; defaults to "Zerodha <TAG>")
# =============================================================================

# Dashboard mode: "live" uses real broker APIs, "mock" uses demo data
APP_MODE=mock

# ── Zerodha Account: ACC1 ─────────────────────────────────────────────────────
ZERODHA_ACC1_API_KEY=
ZERODHA_ACC1_API_SECRET=
ZERODHA_ACC1_ACCESS_TOKEN=
ZERODHA_ACC1_USER_ID=
ZERODHA_ACC1_DISPLAY_NAME=Primary Account

# ── Zerodha Account: ACC2 ─────────────────────────────────────────────────────
ZERODHA_ACC2_API_KEY=
ZERODHA_ACC2_API_SECRET=
ZERODHA_ACC2_ACCESS_TOKEN=
ZERODHA_ACC2_USER_ID=
ZERODHA_ACC2_DISPLAY_NAME=Trading Account

# ── Add more accounts by copying the block above and incrementing the tag ──────
# ZERODHA_ACC3_API_KEY=
# ZERODHA_ACC3_API_SECRET=
# ZERODHA_ACC3_ACCESS_TOKEN=
# ZERODHA_ACC3_USER_ID=
# ZERODHA_ACC3_DISPLAY_NAME=Family Account

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/dashboard.db

# ── Refresh intervals (seconds) ───────────────────────────────────────────────
ACCOUNT_REFRESH_INTERVAL=30
MARKET_DATA_REFRESH_INTERVAL=5
