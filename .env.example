# Copy this file to .env and fill in your credentials
# Dashboard mode: "mock" for demo data, "live" for real broker connections
APP_MODE=mock

# Zerodha Account 1
ZERODHA_ACC1_API_KEY=your_api_key_here
ZERODHA_ACC1_API_SECRET=your_api_secret_here
ZERODHA_ACC1_ACCESS_TOKEN=your_access_token_here
ZERODHA_ACC1_USER_ID=your_user_id_here

# Zerodha Account 2
ZERODHA_ACC2_API_KEY=your_api_key_here
ZERODHA_ACC2_API_SECRET=your_api_secret_here
ZERODHA_ACC2_ACCESS_TOKEN=your_access_token_here
ZERODHA_ACC2_USER_ID=your_user_id_here

# Database
DB_PATH=data/dashboard.db

# Refresh intervals (seconds)
ACCOUNT_REFRESH_INTERVAL=30
MARKET_DATA_REFRESH_INTERVAL=5
